// SimulasiSaham.jsx
import React, { useState } from "react";

const sampleStocks = [
  { code: "BBRI", name: "Bank BRI", price: 5500 },
  { code: "TLKM", name: "Telkom", price: 4200 },
  { code: "GOTO", name: "GoTo", price: 100 },
];

export default function SimulasiSaham() {
  const [balance, setBalance] = useState(1000000);
  const [portfolio, setPortfolio] = useState({});

  const handleBuy = (stock) => {
    if (balance < stock.price) return alert("Saldo tidak cukup");

    const updatedPortfolio = { ...portfolio };
    updatedPortfolio[stock.code] = (updatedPortfolio[stock.code] || 0) + 1;
    setPortfolio(updatedPortfolio);
    setBalance(balance - stock.price);
  };

  const handleSell = (stock) => {
    if (!portfolio[stock.code]) return alert("Kamu belum punya saham ini");

    const updatedPortfolio = { ...portfolio };
    updatedPortfolio[stock.code] -= 1;
    if (updatedPortfolio[stock.code] === 0) delete updatedPortfolio[stock.code];
    setPortfolio(updatedPortfolio);
    setBalance(balance + stock.price);
  };

  return (
    <div className="max-w-2xl mx-auto p-4 space-y-6">
      <h1 className="text-2xl font-bold text-center">📈 Simulasi Platform Saham</h1>
      <div className="text-lg">💰 Saldo: Rp{balance.toLocaleString()}</div>

      <div className="space-y-4">
        {sampleStocks.map((stock) => (
          <div
            key={stock.code}
            className="flex justify-between items-center bg-white p-4 rounded-xl shadow"
          >
            <div>
              <h2 className="font-semibold">{stock.name} ({stock.code})</h2>
              <p className="text-gray-500">Harga: Rp{stock.price}</p>
              <p className="text-sm">Jumlah dimiliki: {portfolio[stock.code] || 0}</p>
            </div>
            <div className="flex gap-2">
              <button
                className="bg-green-500 text-white px-3 py-1 rounded"
                onClick={() => handleBuy(stock)}
              >
                Beli
              </button>
              <button
                className="bg-red-500 text-white px-3 py-1 rounded"
                onClick={() => handleSell(stock)}
              >
                Jual
              </button>
            </div>
          </div>
        ))}
      </div>
    </div>
  );
}
